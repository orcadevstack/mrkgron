# -----------------------------------------------------------------------
# Mrkgron — Environment Variables (.env.example)
# Copy to .env and fill in real values. Never commit .env to version control.
# -----------------------------------------------------------------------

# Django
SECRET_KEY=change-me-in-production-use-50-random-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=mrkgron.settings.development

# Database (PostgreSQL)
DB_NAME=mrkgron
DB_USER=mrkgron
DB_PASSWORD=mrkgron
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable

# Redis
REDIS_URL=redis://localhost:6379/0

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# JWT
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@mrkgron.com
SENDGRID_API_KEY=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Stripe (Payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=mrkgron
AWS_S3_REGION_NAME=us-east-1

# Sentry
SENTRY_DSN=
